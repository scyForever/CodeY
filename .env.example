# Copy this file to .env and fill only the providers you use.

# Optional provider selector. CLI --provider still takes precedence.
CODEY_PROVIDER=deepseek

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
CODEY_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
CODEY_DEEPSEEK_API_KEY=
CODEY_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional right.codes shared key. Used by --provider openai and --provider anthropic when provider-specific keys are empty.
CODEY_RIGHT_CODES_API_KEY=

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
CODEY_OPENAI_API_BASE=https://www.right.codes/codex/v1
CODEY_OPENAI_API_KEY=
CODEY_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint. Can reuse CODEY_RIGHT_CODES_API_KEY when your gateway shares one key.
CODEY_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
CODEY_ANTHROPIC_API_KEY=
CODEY_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional dense semantic Skill routing. Keep off to avoid embedding calls.
# OpenAI-compatible: set provider=openai and use the /v1 embeddings base.
# Ollama: set provider=ollama and configure CODEY_SKILL_EMBEDDING_HOST instead.
CODEY_SKILL_EMBEDDING_PROVIDER=off
CODEY_SKILL_EMBEDDING_API_BASE=https://api.openai.com/v1
CODEY_SKILL_EMBEDDING_API_KEY=
CODEY_SKILL_EMBEDDING_HOST=http://127.0.0.1:11434
CODEY_SKILL_EMBEDDING_MODEL=

# Optional comma-separated extra env names to redact from traces and reports.
CODEY_SECRET_ENV_NAMES=
